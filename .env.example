# Copy this file to `.env` and fill in your CognoDB connection details.
# The real `.env` is gitignored and must never be committed.

# From the CognoDB console, of the form:
#   bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_URI=bolt+s://your-instance-id.databases.cognodb.cloud

# The default CognoDB user.
NEO4J_USERNAME=cognodb

# The password shown exactly once when you created the instance.
NEO4J_PASSWORD=your-password-here